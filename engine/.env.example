# --- Database (Supabase) ---
# App connection (transaction pooler is fine; we set prepare:false).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Direct connection, used only by `npm run db:migrate` / drizzle-kit.
DATABASE_URL_DIRECT=

# --- Payments ---
PAYMENT_PROVIDER=mock            # mock | paystack
PAYSTACK_SECRET_KEY=             # sk_test_... only. sk_live_ is refused unless ALLOW_LIVE_KEYS=true
ALLOW_LIVE_KEYS=false

# --- App ---
APP_URL=http://localhost:3000

# --- Secrets for protected routes (use long random values) ---
DEMO_ADMIN_TOKEN=
CRON_SECRET=
STAFF_API_TOKEN=
PIN_PEPPER=

# --- Money settings ---
DRAWDOWN_FEE_BPS=100             # 1%
DEFAULT_SWEEP_RATE_BPS=1000      # 10%
SWEEP_BUFFER_KOBO=0
